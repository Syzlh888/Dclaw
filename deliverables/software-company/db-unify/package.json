{
  "name": "db-unify",
  "private": true,
  "version": "1.4.0-alpha.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n vite,api -c blue,green \"vite\" \"nodemon server/index.mjs\"",
    "dev:frontend": "vite",
    "dev:backend": "nodemon server/index.mjs",
    "build": "tsc -b && vite build",
    "build:server-bundle": "esbuild server/index.mjs --bundle --platform=node --outfile=scripts/server-bundle.cjs --format=cjs --log-limit=0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "keygen": "node scripts/keygen.mjs",
    "keygen:generate": "node scripts/keygen.mjs --generate-keypair",
    "encrypt:db": "node scripts/encrypt-db-config.mjs",
    "decrypt:db": "node scripts/decrypt-db-config.mjs",
    "db:migrate": "node server/db/migrator.mjs",
    "db:import": "node scripts/import-json.mjs",
    "db:import:dry": "node scripts/import-json.mjs --dry-run",
    "db:import:force": "node scripts/import-json.mjs --force",
    "backup:json": "node scripts/backup-json.mjs",
    "backup:pg": "bash scripts/backup-pg.sh",
    "restore:pg": "bash scripts/restore-pg.sh",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f web"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "pg": "^8.13.0",
    "sm-crypto": "^0.4.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@monaco-editor/react": "^4.6.0",
    "@mui/icons-material": "^5.15.0",
    "@mui/material": "^5.15.0",
    "@tanstack/react-virtual": "^3.5.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/papaparse": "^5.3.14",
    "@types/pg": "^8.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "concurrently": "^8.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.400.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.11.0",
    "nanoid": "^5.0.0",
    "nodemon": "^3.1.14",
    "openai": "^6.44.0",
    "papaparse": "^5.4.0",
    "pg": "^8.13.0",
    "postcss": "^8.4.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.13.0",
    "remark-gfm": "^4.0.1",
    "sql-formatter": "^15.8.1",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vite": "^5.3.0",
    "vitest": "^4.1.8",
    "winston": "^3.15.0",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.0"
  }
}
